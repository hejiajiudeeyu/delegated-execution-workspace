# Node
node_modules/
npm-debug.log*

# Build and runtime artifacts
dist/
build/
coverage/
.tmp/
.run/
.nx/
*.log
*.tsbuildinfo
test-results/
junit.xml

# OS / IDE
.DS_Store
.vscode/

# Env files
.env
.env.local
.env.*.local

# Docker
*.pid

# Test artifacts
tests/reports/latest.json
exports/

# Stack backups. The selfhost plan writes here, and a backup carries API keys
# and the encrypted console credential store — it must never reach a commit.
backups/

# Personal local reference: research notes, positioning drafts, scratch (not workspace contract)
_local_ref/

# Personal tooling metadata (not part of the workspace contract)
.wiki-system.json

# Qoder-generated repowiki (derived docs, regenerated from the repo; hundreds of files)
# Scoped to repowiki/ on purpose: .qoder/ is also a platform config dir
# (.qoder/agents/, .qoder/skills/, .qoder/settings.json) that stays tracked like .codex/.
.qoder/repowiki/

# Stray artifacts from mis-typed pnpm/npm commands
/delegated-execution-workspace@*
/node

# Python bytecode from tools/agent-e2e and similar local python scripts
__pycache__/
*.pyc
